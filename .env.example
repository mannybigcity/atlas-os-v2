NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_ATLAS_BASIC_URL=
NEXT_PUBLIC_STRIPE_ATLAS_GROW_URL=
NEXT_PUBLIC_STRIPE_ATLAS_UNLIMITED_URL=
# Payment Link after_completion redirect (do not change the buy.stripe.com URLs):
# ${NEXT_PUBLIC_SITE_URL}/checkout/success?session_id={CHECKOUT_SESSION_ID}
ATLAS_OBSIDIAN_VAULT_PATH=
ATLAS_SUPER_ADMIN_EMAILS=admin@example.com

# Server-only integrations. Never rename these with a NEXT_PUBLIC_ prefix.
# Keep production values in the deployment provider, not in this file.
GOOGLE_PLACES_API_KEY=
# Do not paste an OpenAI key on Netlify. Enable AI on the site so the
# AI Gateway can inject OPENAI_API_KEY and OPENAI_BASE_URL. A user-defined
# OPENAI_API_KEY disables gateway injection and talks to api.openai.com.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini

# Atlas billing and admin Money surfaces. Use a least-privilege restricted key
# with read access to Balance, PaymentIntents, Checkout Sessions/Line Items,
# Prices, Subscriptions, and Invoices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ATLAS_BASIC_PRICE_ID=
STRIPE_ATLAS_GROW_PRICE_ID=
STRIPE_ATLAS_UNLIMITED_PRICE_ID=

# Private notifications. RESEND_API_KEY and SUPABASE_SERVICE_ROLE_KEY must only
# exist on the server or in Netlify; never add NEXT_PUBLIC_ to either name.
RESEND_API_KEY=
ATLAS_NOTIFICATION_EMAILS=you@example.com
ATLAS_NOTIFICATION_FROM=Atlas <noreply@atlasforentrepreneurs.com>
# Trial signup founder alerts. Defaults to atlasforentrepreneurs@gmail.com when unset.
TRIAL_SIGNUP_NOTIFY_EMAIL=
# Server-only sample desk login. Never add NEXT_PUBLIC_ to these names.
# DEMO_LOGIN_EMAIL defaults to atlasforentrepreneurs+demo@gmail.com.
# Do not set it to atlasforentrepreneurs@gmail.com.
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=

# Daily Content Studio kill switch. Leave false until the migration is applied,
# production secrets are configured, and a manual Netlify "Run now" succeeds.
ATLAS_CONTENT_AUTOMATION_ENABLED=false
