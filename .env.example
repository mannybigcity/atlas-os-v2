NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
ATLAS_OBSIDIAN_VAULT_PATH=
ATLAS_SUPER_ADMIN_EMAILS=admin@example.com

# Server-only integrations. Never rename these with a NEXT_PUBLIC_ prefix.
# Keep production values in the deployment provider, not in this file.
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Private notifications. RESEND_API_KEY and SUPABASE_SERVICE_ROLE_KEY must only
# exist on the server or in Netlify; never add NEXT_PUBLIC_ to either name.
RESEND_API_KEY=
ATLAS_NOTIFICATION_EMAILS=you@example.com
ATLAS_NOTIFICATION_FROM=Atlas Alerts <alerts@updates.atlasforentrepreneurs.com>
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=

# Daily Content Studio kill switch. Leave false until the migration is applied,
# production secrets are configured, and a manual Netlify "Run now" succeeds.
ATLAS_CONTENT_AUTOMATION_ENABLED=false
