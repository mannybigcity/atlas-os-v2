NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
ATLAS_OBSIDIAN_VAULT_PATH=
ATLAS_SUPER_ADMIN_EMAILS=admin@example.com

# Server-only integrations. Never rename these with a NEXT_PUBLIC_ prefix.
# Keep production values in the deployment provider, not in this file.
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Private notifications. RESEND_API_KEY and SUPABASE_SERVICE_ROLE_KEY must only
# exist on the server or in Netlify; never add NEXT_PUBLIC_ to either name.
RESEND_API_KEY=
ATLAS_NOTIFICATION_EMAILS=you@example.com
ATLAS_NOTIFICATION_FROM=Atlas Alerts <alerts@updates.atlasforentrepreneurs.com>
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=

# Daily Content Studio kill switch. Leave false until the migration is applied,
# production secrets are configured, and a manual Netlify "Run now" succeeds.
ATLAS_CONTENT_AUTOMATION_ENABLED=false

# Stripe bookkeeping (Atlas For Entrepreneurs Stripe App, read only).
# Leave false until the owner supplies the keys below and applies the migration.
# These are AFE credentials. Do not put SIS Custom Creations keys here.
STRIPE_BOOKKEEPING_ENABLED=false
# OAuth client id from the Atlas Bookkeeping Stripe App (starts with ca_).
STRIPE_APP_CLIENT_ID=
# App developer account secret key used only to exchange and refresh OAuth tokens.
# Live installs use this key. Server only. Never prefix with NEXT_PUBLIC_.
STRIPE_APP_SECRET_KEY=
# Test-mode or sandbox secret key for external test installs. Server only.
STRIPE_APP_TEST_SECRET_KEY=
# live (default) or test. Must match the install link and the secret key above.
STRIPE_APP_OAUTH_MODE=live
# Optional override for the external-test authorize URL from the Stripe Dashboard.
# Leave blank to use https://marketplace.stripe.com/oauth/v2/authorize.
STRIPE_APP_AUTHORIZE_URL=
# Webhook signing secret (whsec_) for the bookkeeping endpoint. Server only.
STRIPE_WEBHOOK_SECRET=
# Optional second signing secret for the test-mode endpoint. Server only.
STRIPE_WEBHOOK_SECRET_TEST=
# 32-byte key, base64. Encrypts OAuth tokens at rest. Server only.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STRIPE_TOKEN_ENCRYPTION_KEY=
# Shared secret for the backfill background function. Server only.
STRIPE_BOOKKEEPING_JOB_SECRET=
# First sync history window. Integer from 12 to 24. Default 24.
STRIPE_BOOKKEEPING_BACKFILL_MONTHS=24
